<Page x:Class="Giniyatullina_TRPO_5.OrderFormPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Giniyatullina_TRPO_5"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="800"
      Title="OrderFormPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0">
            <Label Content="ID"
                   FontSize="14"/>
            <Label Content="Клиент"
                   FontSize="14"/>
            <Label Content="Дата"
                   FontSize="14"/>
            <Label Content="Статус"
                   FontSize="14"/>
        </StackPanel>

        <StackPanel Grid.Column="1">
            <TextBox Margin="3"
                     FontSize="14"
                     Text="{Binding Id}"/>
            <TextBox Margin="3"
                     FontSize="14"
                     Text="{Binding Client}"/>
            <TextBox Margin="3"
                     FontSize="14"
                     Text="{Binding Date}"/>
            <TextBox Margin="3"
                     FontSize="14"
                     Text="{Binding Status}"/>
        </StackPanel>

        <Label Grid.Row="4" Grid.ColumnSpan="2"
               Content="Позиции заказа"
               FontSize="14"
               FontWeight="Bold"
               HorizontalAlignment="Center"/>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2">
            <StackPanel Orientation="Horizontal">
                <Button Margin="5"
                        Padding="5"
                        FontSize="14"
                        Background="#FFA07A"
                        Content="Добавить позицию"
                        Click="Button_Click_1"/>
                <Button Margin="5"
                        Padding="5"
                        FontSize="14"
                        Background="#FFA07A"
                        Content="Удалить позицию"
                        Click="Button_Click"/>
                <Button Margin="5"
                        Padding="5"
                        FontSize="14"
                        Background="#FFA07A"
                        Content="Изменить позицию"
                        Click="Button_Click_2"/>
            </StackPanel>

            <ListView Height="270"
                      ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=Page}}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" Width="150"/>
                            <TextBlock Text="{Binding Price}" Width="80"/>
                            <TextBlock Text=" x "/>
                            <TextBlock Text="{Binding Count}" Width="50"/>
                            <TextBlock Text=" = "/>
                            <TextBlock Text="{Binding TotalPrice}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <StackPanel Grid.Row="6" Grid.ColumnSpan="3" Orientation="Horizontal">
            <Button Margin="5"
                    Padding="5"
                    FontSize="14"
                    Background="#FFA07A"
                    Content="Назад"
                    Click="Button_Click_4"/>
            <Button Margin="5"
                    Padding="5"
                    FontSize="14"
                    Background="#FFA07A"
                    Content="Сохранить"
                    Click="Button_Click_3"/>
            <Label Content="Итого: "
                   FontSize="14"
                   Margin="5"/>
            <Label Content="{Binding TotalAmount}"
                   FontSize="14"
                   Margin="5"/>
        </StackPanel>
    </Grid>
</Page>
