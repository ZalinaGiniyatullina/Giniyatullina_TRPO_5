<Page x:Class="Giniyatullina_TRPO_5.ListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Giniyatullina_TRPO_5"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="800"
      Title="ListPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal"
                    Grid.Row="0" Grid.ColumnSpan="2"
                    HorizontalAlignment="Center">
            <Button Margin="5"
                    Padding="5"
                    FontSize="14"
                    FontWeight="Bold"
                    Background="#FFA07A"
                    Content="Добавить"
                    Click="Button_Click"/>
            <Button Margin="5"
                    Padding="5"
                    FontSize="14"
                    FontWeight="Bold"
                    Background="#FFA07A"
                    Content="Удалить"
                    Click="Button_Click_1"/>
            <Button Margin="5"
                    Padding="5"
                    FontSize="14"
                    FontWeight="Bold"
                    Background="#FFA07A"
                    Content="Сохранить в JSON"
                    Click="Button_Click_2"/>
        </StackPanel>

        <ListView Grid.Row="1" Grid.ColumnSpan="2"
                  FontSize="12"
                  ItemsSource="{Binding Orders}"
                  SelectedItem="{Binding SelectedOrder}"
                  MouseDoubleClick="ListView_MouseDoubleClick">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Идентификатор: "/>
                            <TextBlock Text="{Binding Id}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Клиент: "/>
                            <TextBlock Text="{Binding Client}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Дата: "/>
                            <TextBlock Text="{Binding Date}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Статус: "/>
                            <TextBlock Text="{Binding Status}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Сумма заказа: "/>
                            <TextBlock Text="{Binding TotalAmount}"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Orientation="Horizontal"
                    Grid.Row="2" Grid.ColumnSpan="2"
                    Background="#FFA07A">
            <Label FontSize="14">Всего в списке:</Label>
            <Label Content="{Binding Orders.Count}"
                   FontSize="14"/>
        </StackPanel>
    </Grid>
</Page>
