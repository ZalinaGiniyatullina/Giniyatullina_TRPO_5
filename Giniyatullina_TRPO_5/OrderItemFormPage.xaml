<Page x:Class="Giniyatullina_TRPO_5.OrderItemFormPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Giniyatullina_TRPO_5"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="800"
      Title="OrderItemFormPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0">
            <Label Content="Наименование"
                   FontSize="14"/>
            <Label Content="Цена"
                   FontSize="14"/>
            <Label Content="Количество"
                   FontSize="14"/>
            <Label Content="Стоимость позиции"
                   FontSize="14"/>
        </StackPanel>

        <StackPanel Grid.Column="1">
            <TextBox Margin="3"
                     FontSize="14"
                     Text="{Binding Name}"/>
            <TextBox Margin="3"
                     FontSize="14"
                     Text="{Binding Price}"/>
            <TextBox Margin="3"
                     FontSize="14"
                     Text="{Binding Count}"/>
            <TextBox Margin="3"
                     IsReadOnly="True"
                     FontSize="14"
                     Text="{Binding TotalPrice}"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <Button Margin="5"
                    Padding="5"
                    Content="Сохранить"
                    FontSize="14"
                    Background="#FFA07A"
                    Click="Button_Click"/>
            <Button Margin="5"
                    Padding="5"
                    Content="Назад"
                    FontSize="14"
                    Background="#FFA07A"
                    Click="Button_Click_1"/>
        </StackPanel>
    </Grid>
</Page>
